# Copy to deploy/.env on the VPS (NEVER commit .env).
# docker compose 는 이 파일을 자동으로 읽는다.
#
# POSTGRES_PASSWORD 는 실제 배포 시 강한 랜덤값으로 교체하고,
# 같은 값을 DATABASE_URL 에도 반영해야 한다.

POSTGRES_USER=localpay
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM
POSTGRES_DB=localpay

# 컨테이너 네트워크 내부 통신: 호스트명 db, 포트 5432
DATABASE_URL=postgresql+asyncpg://localpay:CHANGE_ME_STRONG_RANDOM@db:5432/localpay

ENV=production
LOG_LEVEL=info

# 브라우저 접근이 없으면 빈 값 유지.
CORS_ORIGINS=

# Phase 10 데모용. 실 데이터 임포터 도입 후에는 false 로 바꾸고 필요할 때만 수동 실행.
SEED_ON_START=true

# --- Phase 13 Gate 2+ ---
# 공공데이터포털 (data.go.kr) 에서 발급받는 인증키.
# Dataset 15119539 "한국조폐공사_통합_가맹점기본정보" 활용신청 후 발급.
# 절대 이 값을 git 에 커밋하지 말 것 (.env 는 .gitignore).
DATA_GO_KR_SERVICE_KEY=CHANGE_ME

# --- Phase 13 Gate 3-B1 ---
# Kakao Local Keyword Search API 용 REST API 키.
# https://developers.kakao.com → 앱 생성 → 앱 키 → REST API 키.
# 온누리 매장 좌표 보정 (geocoding) 에 사용. 개발 계정 무료 quota 내.
KAKAO_REST_API_KEY=CHANGE_ME
