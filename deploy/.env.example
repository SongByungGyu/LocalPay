# Copy to deploy/.env on the VPS (NEVER commit .env).
# docker compose 는 이 파일을 자동으로 읽는다.
#
# POSTGRES_PASSWORD 는 실제 배포 시 강한 랜덤값으로 교체하고,
# 같은 값을 DATABASE_URL 에도 반영해야 한다.

POSTGRES_USER=localpay
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM
POSTGRES_DB=localpay

# 컨테이너 네트워크 내부 통신: 호스트명 db, 포트 5432
DATABASE_URL=postgresql+asyncpg://localpay:CHANGE_ME_STRONG_RANDOM@db:5432/localpay

ENV=production
LOG_LEVEL=info

# 브라우저 접근이 없으면 빈 값 유지.
CORS_ORIGINS=

# Phase 10 데모용. 실 데이터 임포터 도입 후에는 false 로 바꾸고 필요할 때만 수동 실행.
SEED_ON_START=true
