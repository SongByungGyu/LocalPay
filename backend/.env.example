# Copy to backend/.env  (NEVER commit .env)
# Docker Compose picks up deploy/.env for compose-level vars.
# This file is what the FastAPI process itself reads.

# Async SQLAlchemy DSN (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://localpay:CHANGE_ME@db:5432/localpay

ENV=production
LOG_LEVEL=info

# Comma-separated origins. Empty = disallow all cross-origin browser access.
CORS_ORIGINS=

# If true, run app.seed.run_seed on container start. Safe to leave true for MVP.
SEED_ON_START=true
